{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install frontend dependencies",
      "type": "process",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build API",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "backend/Pantry.Api.csproj"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
