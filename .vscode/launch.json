{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Run Pantry (full stack)",
      "configurations": ["Pantry API", "Pantry frontend"],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Pantry API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Prepare API",
      "program": "${workspaceFolder}/backend/bin/Debug/net10.0/Pantry.Api.dll",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5050",
        "ConnectionStrings__DefaultConnection": "Host=localhost;Port=5432;Database=pantry;Username=pantry;Password=pantry-local-only",
        "Jwt__Key": "Pantry-local-development-only-signing-key-2026!"
      }
    },
    {
      "name": "Pantry frontend",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "Install frontend dependencies",
      "command": "npm run dev"
    }
  ]
}
